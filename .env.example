export OPENROUTER_API_KEY=your-openrouter-api-key-here
# Only a single OpenRouter API key is required for all configured models.

# Optional OpenRouter headers for attribution
export OPENROUTER_HTTP_REFERER=https://your-app.example
export OPENROUTER_APP_NAME=McGregor-Fellowship

# Optional per-model overrides
export OPENROUTER_MODEL_CLAUDE=anthropic/claude-opus-4.1
export OPENROUTER_MODEL_OPENAI=openai/gpt-4o
export OPENROUTER_MODEL_GROK=x-ai/grok-2
export OPENROUTER_MODEL_GEMINI=google/gemini-2.5-flash
