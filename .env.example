export OPENROUTER_API_KEY=your-openrouter-api-key-here
# Only a single OpenRouter API key is required for all configured models.

# Optional OpenRouter headers for attribution
export OPENROUTER_HTTP_REFERER=https://your-app.example
export OPENROUTER_APP_NAME=McGregor-Fellowship

# Optional per-model overrides
export OPENROUTER_MODEL_CLAUDE=~anthropic/claude-sonnet-latest
export OPENROUTER_MODEL_OPENAI=~openai/gpt-latest
export OPENROUTER_MODEL_GROK=x-ai/grok-4.3
export OPENROUTER_MODEL_GEMINI=~google/gemini-3.5-flash
export OPENROUTER_MODEL_DEEPSEEK=deepseek/deepseek-v4-pro
export OPENROUTER_MODEL_GLM=~z-ai/glm-5.2
